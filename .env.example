# Read by `netlify dev` for local testing of netlify/functions/mcp-publish.
# In production these are NOT set via a file — they're set in the Netlify
# dashboard: Site configuration -> Environment variables. Netlify injects
# them into the function at runtime the same way either way.

# Self-generated shared secret Frekto sends as `Authorization: Bearer <this>`.
# Make it up yourself (e.g. `openssl rand -hex 32`) and put the SAME value
# in Frekto's MCP config. This is NOT a GitHub token and GitHub never sees it.
MCP_AUTH_TOKEN=

# GitHub token used ONLY by this function to commit posts. Use a
# fine-grained Personal Access Token scoped to just this one repo, with
# "Contents: Read and write" permission and nothing else. Frekto never
# sees this token — it only ever talks to MCP_AUTH_TOKEN above.
GITHUB_TOKEN=

GITHUB_OWNER=vish-n-u-k
GITHUB_REPO=orange-theme
GITHUB_BRANCH=main

# Used to turn Frekto's plain-text post body into paragraph HTML (light
# formatting only — wording is preserved as drafted). Get one at
# console.anthropic.com.
ANTHROPIC_API_KEY=

# Absolute origin the site is served from, e.g. https://emberandroast.com
# Used to build sitemap.xml and the blog listing page's canonical tag. If
# unset, sitemap.xml updates are skipped (with a warning) and the listing
# page's canonical falls back to a relative /blog/.
SITE_BASE_URL=

# Only used by netlify/functions/mcp-publish/local.js (the non-Netlify-CLI
# fallback local runner) — irrelevant on Netlify itself.
PORT=3000
